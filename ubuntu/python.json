	"fenwick tree(BIT)": {
		"prefix": "bit",
		"body": [
			"class BIT:",
			"    def __init__(self, n: int|list[int]):",
			"        self.n = len(n) if isinstance(n, list) else n",
			"        self.size = 1 << (self.n - 1).bit_length()",
			"        if isinstance(n, list):  # nは1-indexedなリスト",
			"            a = [0]",
			"            for p in n:",
			"                a.append(p + a[-1])",
			"            a += [a[-1]] * (self.size - self.n)",
			"            self.d = [a[p] - a[p - (p & -p)] for p in range(self.size + 1)]",
			"        else:  # nは大きさ",
			"            self.d = [0] * (self.size + 1)",
			"",
			"    def __repr__(self):",
			"        p = self.size",
			"        res: list[str] = []",
			"        while p > 0:",
			"            res2: list[str] = []",
			"            for r in range(p, self.size + 1, p * 2):",
			"                l = r - (r & -r) + 1",
			"                res2.append(f'[{l}, {r}]:{self.d[r]}')",
			"            res.append(' '.join(res2))",
			"            p >>= 1",
			"        res.append(f'{[self.sum(p + 1) - self.sum(p) for p in range(self.size)]}')",
			"        return '\\n'.join(res)",
			"",
			"    def add(self, p: int, x: int):  # O(log(n)), 点pにxを加算",
			"        assert p > 0",
			"        while p <= self.size:",
			"            self.d[p] += x",
			"            p += p & -p",
			"",
			"    def get(self, p: int, default: int|None =None) -> int:  # O(log(n))",
			"        assert p > 0",
			"        return self.sum(p) - self.sum(p - 1) if 1 <= p <= self.n or default is None else default",
			"",
			"    def sum(self, p: int) -> int:  # O(log(n)), 閉区間[1, p]の累積和",
			"        assert p >= 0",
			"        res = 0",
			"        while p > 0:",
			"            res += self.d[p]",
			"            p -= p & -p",
			"        return res",
			"",
			"    def lower_bound(self, x: int) -> int:  # O(log(n)), x <= 閉区間[1, p]の累積和 となる最小のp",
			"        if x <= 0:",
			"            return 0",
			"        p, r = 0, self.size",
			"        while r > 0:",
			"            if p + r <= self.n and self.d[p + r] < x:",
			"                x -= self.d[p + r]",
			"                p += r",
			"            r >>= 1",
			"        return p + 1",
			""
		],
		"description": "fenwick tree(BIT)"
	},

	"転倒数": {
		"prefix": "inversion",
		"body": [
			"from bisect import bisect_left",
			"",
			"",
			"class BIT:",
			"    def __init__(self, n: int|list[int]):",
			"        self.n = len(n) if isinstance(n, list) else n",
			"        self.size = 1 << (self.n - 1).bit_length()",
			"        if isinstance(n, list):  # nは1-indexedなリスト",
			"            a = [0]",
			"            for p in n:",
			"                a.append(p + a[-1])",
			"            a += [a[-1]] * (self.size - self.n)",
			"            self.d = [a[p] - a[p - (p & -p)] for p in range(self.size + 1)]",
			"        else:  # nは大きさ",
			"            self.d = [0] * (self.size + 1)",
			"",
			"    def __repr__(self):",
			"        p = self.size",
			"        res: list[str] = []",
			"        while p > 0:",
			"            res2: list[str] = []",
			"            for r in range(p, self.size + 1, p * 2):",
			"                l = r - (r & -r) + 1",
			"                res2.append(f'[{l}, {r}]:{self.d[r]}')",
			"            res.append(' '.join(res2))",
			"            p >>= 1",
			"        res.append(f'{[self.sum(p + 1) - self.sum(p) for p in range(self.size)]}')",
			"        return '\\n'.join(res)",
			"",
			"    def add(self, p: int, x: int):  # O(log(n)), 点pにxを加算",
			"        assert p > 0",
			"        while p <= self.size:",
			"            self.d[p] += x",
			"            p += p & -p",
			"",
			"    def get(self, p: int, default: int|None =None) -> int:  # O(log(n))",
			"        assert p > 0",
			"        return self.sum(p) - self.sum(p - 1) if 1 <= p <= self.n or default is None else default",
			"",
			"    def sum(self, p: int) -> int:  # O(log(n)), 閉区間[1, p]の累積和",
			"        assert p >= 0",
			"        res = 0",
			"        while p > 0:",
			"            res += self.d[p]",
			"            p -= p & -p",
			"        return res",
			"",
			"    def lower_bound(self, x: int) -> int:  # O(log(n)), x <= 閉区間[1, p]の累積和 となる最小のp",
			"        if x <= 0:",
			"            return 0",
			"        p, r = 0, self.size",
			"        while r > 0:",
			"            if p + r <= self.n and self.d[p + r] < x:",
			"                x -= self.d[p + r]",
			"                p += r",
			"            r >>= 1",
			"        return p + 1",
			"",
			"# 転倒数を求める（必要ならXは座圧しておく）",
			"def num_inversion(X: list[int]):",
			"    MAX = max(X)",
			"    bit = BIT(MAX)",
			"    res = 0",
			"    for x in X:",
			"        # 「xより左にあるxより大きい数」の個数を足す",
			"        res += bit.sum(MAX) - bit.sum(x)",
			"        bit.add(x, 1)",
			"    return res",
			"",
			"def np_x_compress(x: list[int]):  # 座圧を1-indexedに修正",
