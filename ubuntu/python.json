	"non-recursive dfs(Euler-Tour)": {
		"prefix": "dfs",
		"body": [
			"q: list[tuple[int, int]] = [(0, ~start), (0, start)]",
			"vis: list[bool] = [False]*n",
			"finished: list[bool] = [False]*n",
			"",
			"# 問題固有の前処理",
			"max_dist = 0",
			"max_pos = None",
			"",
			"while q:",
			"    d, pos = q.pop()",
			"    if pos >= 0:",
			"        if finished[pos]:",
			"            continue",
			"        vis[pos] = True",
			"        # 行きがけ順の処理（最大距離と都市を求める）",
			"        if max_dist < d:",
			"            max_dist = d",
			"            max_pos = pos",
			"        # 次の位置を探索する",
			"        for dest in G[pos]:",
			"            if vis[dest]:",
			"                continue",
			"            q.append((d+1, ~dest))",
			"            q.append((d+1, dest))",
			"    else:",
			"        pos = ~pos",
			"        if finished[pos]:",
			"            continue",
			"        finished[pos] = True",
			"        # 帰りがけ順の処理",
