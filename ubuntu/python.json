			"",
			"def is_prime(n: int):",
			"  \"\"\"Miller-Rabin Primality Test for n < 4,749,123,141 (approx 10^9)",
			"",
			"  Args:",
			"      n (int): a number to be tested wether it's a prime or not",
			"  \"\"\"",
			"",
			"  a = [2, 7, 61]",
