	"ncr_table":{
		"prefix": "ncr_table",
		"body": [
			"MAX = 200000",
			"MOD = 1000000007",
			"fac = [0]*MAX",
			"finv = [0]*MAX",
			"inv = [0]*MAX",
			"",
			"def COMinit():",
				"    global fac,finv,inv",
				"    fac[0] = fac[1] = 1",
				"    finv[0] = finv[1] = 1",
				"    inv[1] = 1",
				"    for i in range(2,MAX):",
					"        fac[i] = fac[i-1] * i % MOD",
					"        inv[i] = MOD - inv[MOD%i] * (MOD // i) % MOD",
					"        finv[i] = finv[i - 1] * inv[i] % MOD",
			"",
			"def nCr(n:int, r:int) -> int:",
				"    if n < r: return 0",
				"    if n < 0 or r < 0: return 0",
				"    return fac[n] * (finv[r] * finv[n - r] % MOD) % MOD",
			"",
			"def nPr(n:int, r:int) -> int:",
			"    if n < r: return 0",
			"    if n < 0 or r < 0: return 0",
			"    return fac[n] * finv[n - r] % MOD",
			"",
			"COMinit()",
			"$1"
		]
	},

	"ncr_small":{
		"prefix": "ncr_small",
		"body": [
			"from operator import mul",
			"from functools import reduce",
			"",
			"def nCr(n: int, r: int) -> int:",
				"    if n < r: return 0",
				"    r = min(n-r,r)",
				"    if r == 0: return 1",
				"    over = reduce(mul, range(n, n - r, -1))",
				"    under = reduce(mul, range(1,r + 1))",
				"    return over // under",
			"",
			"$1"
		],
		"description": "call a function calculates the combination. Available when n is small"
	},

	"ncr_large":{
		"prefix": "ncr_large",
		"body": [
			"def nCr(n: int, r: int) -> int:",
				"    if n < r: return 0",
				"    if n - r < r: r = n - r",
				"    if r == 0: return 1",
				"    if r == 1: return n",
				"",
				"    numerator = [n - r + k + 1 for k in range(r)]",
				"    denominator = [k + 1 for k in range(r)]",
				"",
				"    for p in range(2,r+1):",
					"        pivot = denominator[p - 1]",
					"        if pivot > 1:",
						"            offset = (n - r) % p",
						"            for k in range(p-1,r,p):",
							"                numerator[k - offset] /= pivot",
							"                denominator[k] /= pivot",
				"",
				"    result = 1",
				"    for k in range(r):",
					"        if numerator[k] > 1:",
						"            result *= int(numerator[k])",
				"",
				"    return result",
			"$1"
		],
		"description": "call a function calculates the combination. Available when n is large"
	},

	"uf": {
		"prefix": "uf",
		"body": [
			"from collections import defaultdict",
			"",
			"",
			"class UnionFind():",
			"    \"\"\"",
			"    Union Find木クラス",
			"    0-index",
			"",
			"    Attributes",
			"    --------------------",
			"    n : int",
			"        要素数",
			"    root : list",
			"        木の要素数",
			"        0未満であればそのノードが根であり、添字の値が要素数",
			"    rank : list",
			"        木の深さ",
			"    \"\"\"",
			"",
			"    def __init__(self, n: int) -> None:",
			"        \"\"\"",
			"        Parameters",
			"        ---------------------",
			"        n : int",
			"            要素数",
			"        \"\"\"",
			"        self.n = n",
			"        self.root = [-1]*n",
			"        self._size = n",
			"",
			"    def find(self, x: int) -> int:",
			"        \"\"\"",
			"        ノードxの根を見つける",
			"",
			"        Parameters",
			"        ---------------------",
			"        x : int",
			"            見つけるノード",
			"",
			"        Returns",
			"        ---------------------",
			"        root : int",
			"            根のノード",
			"        \"\"\"",
			"        if(self.root[x] < 0):",
			"            return x",
			"        else:",
			"            self.root[x] = self.find(self.root[x])",
			"            return self.root[x]",
			"",
			"    def unite(self, x: int, y: int) -> None:",
			"        \"\"\"",
			"        木の併合",
			"",
			"        Parameters",
			"        ---------------------",
			"        x : int",
			"            併合したノード",
			"        y : int",
			"            併合したノード",
			"        \"\"\"",
			"        x = self.find(x)",
			"        y = self.find(y)",
			"",
			"        if(x == y):",
			"            return",
			"        if -self.root[x] < -self.root[y]:",
			"            x, y = y, x",
			"        self.root[x] += self.root[y]",
			"        self.root[y] = x",
			"",
			"        self._size -= 1",
			"",
			"    def same(self, x: int, y: int) -> bool:",
			"        \"\"\"",
			"        同じグループに属するか判定",
			"",
			"        Parameters",
			"        ---------------------",
			"        x : int",
			"            判定したノード",
			"        y : int",
			"            判定したノード",
			"",
			"        Returns",
			"        ---------------------",
			"        ans : bool",
			"            同じグループに属しているか",
			"        \"\"\"",
			"        return self.find(x) == self.find(y)",
			"",
			"    def size(self, x: int) -> int:",
			"        \"\"\"",
			"        木のサイズを計算",
			"",
			"        Parameters",
			"        ---------------------",
			"        x : int",
			"            計算したい木のノード",
			"",
			"        Returns",
			"        ---------------------",
			"        size : int",
			"            木のサイズ",
			"        \"\"\"",
			"        return -self.root[self.find(x)]",
			"",
			"    def roots(self) -> list[int]:",
			"        \"\"\"",
			"        根のノードを取得",
			"",
			"        Returns",
			"        ---------------------",
			"        roots : list",
			"            根のノード",
			"        \"\"\"",
			"        return [i for i, x in enumerate(self.root) if x < 0]",
			"",
			"    def group_size(self) -> int:",
			"        \"\"\"",
			"        グループ数を取得",
			"",
			"        Returns",
			"        ---------------------",
			"        size : int",
			"            グループ数",
			"        \"\"\"",
			"        return self._size",
			"",
			"    def group_members(self) -> defaultdict[int, list[int]]:",
			"        \"\"\"",
			"        全てのグループごとのノードを取得",
			"",
			"        Returns",
			"        ---------------------",
			"        group_members : defaultdict",
			"            根をキーとしたノードのリスト",
			"        \"\"\"",
			"        group_members: defaultdict[int, list[int]] = defaultdict(list)",
			"        for member in range(self.n):",
			"            group_members[self.find(member)].append(member)",
			"        return group_members",
			""
		],
		"description": "uf"
	},

	"wuf": {
		"prefix": "wuf",
		"body": [
			"from collections import defaultdict",
			"",
			"",
			"class WeightedUnionFind():",
			"    \"\"\"",
			"    Union Find木クラス",
			"    0-index",
			"",
			"    Attributes",
			"    --------------------",
			"    n : int",
			"        要素数",
			"    root : list",
			"        木の要素数",
			"        0未満であればそのノードが根であり、添字の値が要素数",
			"    rank : list",
			"        木の深さ",
			"    \"\"\"",
			"",
			"    def __init__(self, n: int) -> None:",
			"        \"\"\"",
			"        Parameters",
			"        ---------------------",
			"        n : int",
			"            要素数",
			"        \"\"\"",
			"        self.n = n",
			"        self.root = [-1]*n",
			"        self.rank = [0]*n",
			"        self._size = n",
			"        self.diff_weight = [0]*n",
			"",
			"    def find(self, x: int) -> int:",
			"        \"\"\"",
			"        ノードxの根を見つける",
			"",
			"        Parameters",
			"        ---------------------",
			"        x : int",
			"            見つけるノード",
			"",
			"        Returns",
			"        ---------------------",
			"        root : int",
			"            根のノード",
			"        \"\"\"",
			"        if(self.root[x] < 0):",
			"            return x",
			"        else:",
			"            r = self.find(self.root[x])",
			"            self.diff_weight[x] += self.diff_weight[self.root[x]]",
			"            self.root[x] = r",
			"            return self.root[x]",
			"",
			"    def unite(self, x: int, y: int, w: int) -> None:",
			"        \"\"\"",
			"        木の併合",
			"",
			"        Parameters",
			"        ---------------------",
			"        x : int",
			"            併合したノード",
			"        y : int",
			"            併合したノード",
			"        w : int",
			"            有向辺 x -> y の重み",
			"        \"\"\"",
			"        w += self.weight(x) - self.weight(y)",
			"        x = self.find(x)",
			"        y = self.find(y)",
			"",
			"        if(x == y):",
			"            return",
			"        elif(self.rank[x] > self.rank[y]):",
			"            self.root[x] += self.root[y]",
			"            self.root[y] = x",
			"            self.diff_weight[y] = w",
			"        else:",
			"            w *= -1",
			"            self.root[y] += self.root[x]",
			"            self.root[x] = y",
			"            self.diff_weight[x] = w",
			"            if(self.rank[x] == self.rank[y]):",
			"                self.rank[y] += 1",
			"",
			"        self._size -= 1",
			"",
			"    def weight(self, x: int) -> int:",
			"        self.find(x)",
			"        return self.diff_weight[x]",
			"",
			"    def diff(self, x: int, y: int) -> int:",
			"        return self.weight(y) - self.weight(x)",
			"",
			"    def same(self, x: int, y: int) -> bool:",
			"        \"\"\"",
			"        同じグループに属するか判定",
			"",
			"        Parameters",
			"        ---------------------",
			"        x : int",
			"            判定したノード",
			"        y : int",
			"            判定したノード",
			"",
			"        Returns",
			"        ---------------------",
			"        ans : bool",
			"            同じグループに属しているか",
			"        \"\"\"",
			"        return self.find(x) == self.find(y)",
			"",
			"    def size(self, x: int) -> int:",
			"        \"\"\"",
			"        木のサイズを計算",
			"",
			"        Parameters",
			"        ---------------------",
			"        x : int",
			"            計算したい木のノード",
			"",
			"        Returns",
			"        ---------------------",
			"        size : int",
			"            木のサイズ",
			"        \"\"\"",
			"        return -self.root[self.find(x)]",
			"",
			"    def roots(self) -> list[int]:",
			"        \"\"\"",
			"        根のノードを取得",
			"",
			"        Returns",
			"        ---------------------",
			"        roots : list",
			"            根のノード",
			"        \"\"\"",
			"        return [i for i, x in enumerate(self.root) if x < 0]",
			"",
			"    def group_size(self) -> int:",
			"        \"\"\"",
			"        グループ数を取得",
			"",
			"        Returns",
			"        ---------------------",
			"        size : int",
			"            グループ数",
			"        \"\"\"",
			"        return self._size",
			"",
			"    def group_members(self) -> defaultdict[int, list[int]]:",
			"        \"\"\"",
			"        全てのグループごとのノードを取得",
			"",
			"        Returns",
			"        ---------------------",
			"        group_members : defaultdict",
			"            根をキーとしたノードのリスト",
			"        \"\"\"",
			"        group_members: defaultdict[int, list[int]] = defaultdict(list)",
			"        for member in range(self.n):",
			"            group_members[self.find(member)].append(member)",
			"        return group_members",
			""
		],
		"description": "wuf"
	},

	"sieve of atkins": {
		"prefix": "sieve_of_atkins",
		"body": [
			"def sieve_atkins(M: int) -> list[int]:",
			"    if M == 2:",
			"        return [2]",
			"    p = [0]*(M+60)",
			"    sM = M**0.5",
			"    for x in range(1, int(sM/2)+1):",
			"        v = 4*x*x + 1; y = 8",
			"        while v <= M:",
			"            if v % 12 != 9: # v % 12 in [1, 5]",
			"                p[v] ^= 1",
			"            v += y; y += 8",
			"    for x in range(1, int(sM/3**0.5)+1, 2):",
			"        v = 3*x*x + 4; y = 12",
			"        while v <= M:",
			"            if v % 12 == 7:",
			"                p[v] ^= 1",
			"            v += y; y += 8",
			"    for x in range(2, int(sM/2**0.5)+1):",
			"        v = 2*x*(x+1)-1; y = 4*x-8",
			"        while 0 <= y and v <= M:",
			"            if v % 12 == 11:",
			"                p[v] ^= 1",
			"            v += y; y -= 8",
			"",
			"    for n in range(5, int(sM)+1):",
			"        if p[n]:",
			"            for z in range(n*n, M, n*n):",
			"                p[z] = 0",
			"    p[2] = p[3] = 1",
			"",
			"    \"\"\"",
			"        return: [2, 3, 5, 7, ...]",
			"    \"\"\"",
			"    return [i for i, x in enumerate(p) if x == 1]",
			""
		],
		"description": "sieve of atkins"
	},

	"tatyamさんの平方分割sortedset": {
		"prefix": "sortedset-tatyam",
		"body": [
			"# https://github.com/tatyam-prime/SortedSet/blob/main/SortedSet.py",
			"from __future__ import annotations",
			"import math",
			"from bisect import bisect_left, bisect_right",
			"from typing import Any, Generic, Iterable, Iterator, Protocol, TypeVar, Optional, cast",
			"",
			"",
			"_T_contra = TypeVar(\"_T_contra\", contravariant=True)",
			"",
			"class SupportsRichComparison(Protocol[_T_contra]):",
			"    def __lt__(self, other: _T_contra, /) -> bool: ...",
			"    def __le__(self, other: _T_contra, /) -> bool: ...",
			"    def __gt__(self, other: _T_contra, /) -> bool: ...",
			"    def __ge__(self, other: _T_contra, /) -> bool: ...",
			"",
			"SupportsRichComparisonT = TypeVar(\"SupportsRichComparisonT\", bound=SupportsRichComparison[Any])",
			"",
			"class SortedSet(Generic[SupportsRichComparisonT]):",
			"    BUCKET_RATIO = 50",
			"    REBUILD_RATIO = 170",
			"",
			"    def _build(self, a: Optional[list[SupportsRichComparisonT]] = None) -> None:",
			"        \"Evenly divide `a` into buckets.\"",
			"        if a is None:",
			"            a = list(self)",
			"        size = self.size = len(a)",
			"        bucket_size = int(math.ceil(math.sqrt(size / self.BUCKET_RATIO)))",
			"        self.a = [a[size * i // bucket_size : size * (i + 1) // bucket_size] for i in range(bucket_size)]",
			"",
			"    def __init__(self, a: Iterable[SupportsRichComparisonT]|None = None) -> None:",
			"        \"Make a new SortedSet from iterable. / O(N) if sorted and unique / O(N log N)\"",
			"        if a is None:",
			"            a = []",
			"        a = list(a)",
			"        if not all(a[i] < a[i + 1] for i in range(len(a) - 1)):",
			"            a = sorted(set(a))",
			"        self._build(a)",
			"",
			"    def __iter__(self) -> Iterator[SupportsRichComparisonT]:",
			"        for i in self.a:",
			"            for j in i:",
			"                yield j",
			"",
			"    def __reversed__(self) -> Iterator[SupportsRichComparisonT]:",
			"        for i in reversed(self.a):",
			"            for j in reversed(i):",
			"                yield j",
			"",
			"    def __eq__(self, other: object) -> bool:",
			"        if not isinstance(other, Iterable):",
			"            return False",
			"",
			"        return list(self) == list(cast(Iterable[Any], other))",
			"",
			"    def __len__(self) -> int:",
			"        return self.size",
			"",
			"    def __repr__(self) -> str:",
			"        return \"SortedSet\" + str(self.a)",
			"",
			"    def __str__(self) -> str:",
			"        s = str(list(self))",
			"        return \"{\" + s[1 : len(s) - 1] + \"}\"",
			"",
			"    def _position(self, x: SupportsRichComparisonT) -> tuple[list[SupportsRichComparisonT], int]:",
			"        \"Find the bucket and position which x should be inserted. self must not be empty.\"",
			"        assert self.a",
			"        for a in self.a:",
			"            if x <= a[-1]:",
			"                break",
			"        return (a, bisect_left(a, x))",
			"",
			"    def __contains__(self, x: SupportsRichComparisonT) -> bool:",
			"        if self.size == 0:",
			"            return False",
			"        a, i = self._position(x)",
			"        return i != len(a) and a[i] == x",
			"",
			"    def add(self, x: SupportsRichComparisonT) -> bool:",
			"        \"Add an element and return True if added. / O(√N)\"",
			"        if self.size == 0:",
			"            self.a = [[x]]",
			"            self.size = 1",
			"            return True",
			"        a, i = self._position(x)",
			"        if i != len(a) and a[i] == x:",
			"            return False",
			"        a.insert(i, x)",
			"        self.size += 1",
			"        if len(a) > len(self.a) * self.REBUILD_RATIO:",
			"            self._build()",
			"        return True",
			"",
			"    def _pop(self, a: list[SupportsRichComparisonT], i: int) -> SupportsRichComparisonT:",
			"        ans = a.pop(i)",
			"        self.size -= 1",
			"        if not a:",
			"            self._build()",
			"        return ans",
			"",
			"    def discard(self, x: SupportsRichComparisonT) -> bool:",
			"        \"Remove an element and return True if removed. / O(√N)\"",
			"        if self.size == 0:",
			"            return False",
			"        a, i = self._position(x)",
			"        if i == len(a) or a[i] != x:",
			"            return False",
			"        self._pop(a, i)",
			"        return True",
			"",
			"    def lt(self, x: SupportsRichComparisonT) -> Optional[SupportsRichComparisonT]:",
			"        \"Find the largest element < x, or None if it doesn't exist.\"",
			"        for a in reversed(self.a):",
			"            if a[0] < x:",
			"                return a[bisect_left(a, x) - 1]",
			"",
			"    def le(self, x: SupportsRichComparisonT) -> Optional[SupportsRichComparisonT]:",
			"        \"Find the largest element <= x, or None if it doesn't exist.\"",
			"        for a in reversed(self.a):",
			"            if a[0] <= x:",
			"                return a[bisect_right(a, x) - 1]",
			"",
			"    def gt(self, x: SupportsRichComparisonT) -> Optional[SupportsRichComparisonT]:",
			"        \"Find the smallest element > x, or None if it doesn't exist.\"",
			"        for a in self.a:",
			"            if a[-1] > x:",
			"                return a[bisect_right(a, x)]",
			"",
			"    def ge(self, x: SupportsRichComparisonT) -> Optional[SupportsRichComparisonT]:",
			"        \"Find the smallest element >= x, or None if it doesn't exist.\"",
			"        for a in self.a:",
			"            if a[-1] >= x:",
			"                return a[bisect_left(a, x)]",
			"",
			"    def __getitem__(self, i: int) -> SupportsRichComparisonT:",
			"        \"Return the i-th element.\"",
			"        if i < 0:",
			"            for a in reversed(self.a):",
			"                i += len(a)",
			"                if i >= 0:",
			"                    return a[i]",
			"        else:",
			"            for a in self.a:",
			"                if i < len(a):",
			"                    return a[i]",
			"                i -= len(a)",
			"        raise IndexError",
			"",
			"    def pop(self, i: int = -1) -> SupportsRichComparisonT:",
			"        \"Pop and return the i-th element.\"",
			"        if i < 0:",
			"            for a in reversed(self.a):",
			"                i += len(a)",
			"                if i >= 0:",
			"                    return self._pop(a, i)",
			"        else:",
			"            for a in self.a:",
			"                if i < len(a):",
			"                    return self._pop(a, i)",
			"                i -= len(a)",
			"        raise IndexError",
			"",
			"    def index(self, x: SupportsRichComparisonT) -> int:",
			"        \"Count the number of elements < x.\"",
			"        ans = 0",
			"        for a in self.a:",
			"            if a[-1] >= x:",
			"                return ans + bisect_left(a, x)",
			"            ans += len(a)",
			"        return ans",
			"",
			"    def index_right(self, x: SupportsRichComparisonT) -> int:",
			"        \"Count the number of elements <= x.\"",
			"        ans = 0",
			"        for a in self.a:",
			"            if a[-1] > x:",
			"                return ans + bisect_right(a, x)",
			"            ans += len(a)",
			"        return ans",
			""
		],
		"description": "tatyamさんの平方分割sortedset"
	},

	"遅延セグ木": {
		"prefix": "lazysegmenttree",
		"body": [
			"from typing import Callable, Generic, Protocol, TypeAlias, TypeVar, runtime_checkable",
			"from operator import add",
			"",
			"",
			"@runtime_checkable",
			"class ImmutableProtocol(Protocol):",
			"    def __hash__(self) -> int: ...",
			"    def __eq__(self, other: object, /) -> bool: ...",
			"",
			"T = TypeVar(\"T\", bound=ImmutableProtocol)",
			"F = TypeVar(\"F\", bound=ImmutableProtocol)",
			"",
			"class LazySegmentTree(Generic[T, F]):",
			"    def __init__(self, op: Callable[[T, T], T], e: T, mapping: Callable[[F, T], T], composition: Callable[[F, F], F], id_: F, n: int|list[T]):",
			"        \"\"\"遅延セグ木",
			"",
			"        Args:",
			"            op (Callable[[T, T], T]): 要素同士の結合演算。モノイド",
			"            e (T): opの単位元",
			"            mapping (Callable[[F, T], T]): 要素に作用素fを作用させる演算",
			"            composition (Callable[[F, F], F]): 遅延により作用素f同士が衝突した際の結合",
			"            id_ (F): 作用の恒等写像。",
			"            n (Union[list[T], int]): 元の配列",
			"        \"\"\"",
			"        self._n = len(n) if isinstance(n, list) else n",
			"        self.op = op",
			"        self.e = e",
			"        self.mapping = mapping",
			"        self.composition = composition",
			"        self.id = id_",
			"        self.log = (self._n - 1).bit_length()",
			"        self.size = 1 << self.log",
			"        self.d = [e]*(2*self.size)",
			"        self.lz = [id_]*self.size",
			"        if isinstance(n, list):",
			"            self.d[self.size: self.size + self._n] = n",
			"        for i in reversed(range(1, self.size)):",
			"            self._update(i)",
			"",
			"    def __repr__(self):",
			"        l, r = 1, 2",
			"        res: list[str] = []",
			"        np_T: Callable[[list[list[T]|list[F]]], list[list[T|F]]] = lambda x: [list(x) for x in zip(*x)]",
			"        while r <= self.size:",
			"            res.append(f'{np_T([self.d[l: r], self.lz[l: r]])}')",
			"            l, r = r, r << 1",
			"        res.append(f'{self.d[l: r]}')",
			"        return '\\n'.join(res)",
			"",
			"    def __setitem__(self, p: int, x: T) -> None:",
			"        self.set(p, x)",
			"",
			"    def __getitem__(self, p: int) -> T:",
			"        return self.get(p)",
			"",
			"    def set(self, p: int, x: T) -> None:    # O(log n)",
			"        p += self.size",
			"        for i in reversed(range(1, self.log + 1)):",
			"            self._push(p >> i)",
			"        self.d[p] = x",
			"        for i in range(1, self.log + 1):",
			"            self._update(p >> i)",
			"",
			"    def get(self, p: int) -> T:         # O(log n)",
			"        p += self.size",
			"        for i in reversed(range(1, self.log + 1)):",
			"            self._push(p >> i)",
			"        return self.d[p]",
			"",
			"    def prod(self, l: int, r: int) -> T:    # [l, r)     O(log n)",
			"        if l == r:",
			"            return self.e",
			"        l += self.size",
			"        r += self.size",
			"        for i in reversed(range(1, self.log + 1)):",
			"            if ((l >> i) << i) != l:",
			"                self._push(l >> i)",
			"            if ((r >> i) << i) != r:",
			"                self._push((r - 1) >> i)",
			"        sml, smr = self.e, self.e",
			"        while (l < r):",
			"            if l & 1:",
			"                sml = self.op(sml, self.d[l])",
			"                l += 1",
			"            if r & 1:",
			"                r -= 1",
			"                smr = self.op(self.d[r], smr)",
			"            l >>= 1",
			"            r >>= 1",
			"        return self.op(sml, smr)",
			"",
			"    def all_prod(self) -> T:                         # O(1)",
			"        return self.d[1]",
			"",
			"    def apply(self, p: int, f: F):                    # O(log n)",
			"        p += self.size",
			"        for i in reversed(range(1, self.log + 1)):",
			"            self._push(p >> i)",
			"        self.d[p] = self.mapping(f, self.d[p])",
			"        for i in range(1, self.log + 1):",
			"            self._update(p >> i)",
			"",
			"    def apply_seg(self, l: int, r: int, f: F):     # O(log n)",
			"        if l == r:",
			"            return",
			"        l += self.size",
			"        r += self.size",
			"        for i in reversed(range(1, self.log + 1)):",
			"            if ((l >> i) << i) != l:",
			"                self._push(l >> i)",
			"            if ((r >> i) << i) != r:",
			"                self._push((r - 1) >> i)",
			"        l2, r2 = l, r",
			"        while l < r:",
			"            if l & 1:",
			"                self._all_apply(l, f)",
			"                l += 1",
			"            if r & 1:",
			"                r -= 1",
			"                self._all_apply(r, f)",
			"            l >>= 1",
			"            r >>= 1",
			"        l, r = l2, r2",
			"        for i in range(1, self.log + 1):",
			"            if ((l >> i) << i) != l:",
			"                self._update(l >> i)",
			"            if ((r >> i) << i) != r:",
			"                self._update((r - 1) >> i)",
			"",
			"    def max_right(self, l: int, f: Callable[[T], bool]):     # O(log n)",
			"        if l >= self._n:",
			"            return self._n",
			"        l = max(l, 0) + self.size",
			"        for i in reversed(range(1, self.log + 1)):",
			"            self._push(l >> i)",
			"        sm = self.e",
			"        while True:",
			"            while l % 2 == 0:",
			"                l >>= 1",
			"            if not f(self.op(sm, self.d[l])):",
			"                while l < self.size:",
			"                    self._push(l)",
			"                    l <<= 1",
			"                    if f(self.op(sm, self.d[l])):",
			"                        sm = self.op(sm, self.d[l])",
			"                        l += 1",
			"                return l - self.size",
			"            sm = self.op(sm, self.d[l])",
			"            l += 1",
			"            if l & -l == l:",
			"                break",
			"        return self._n",
			"",
			"    def min_left(self, r: int, f: Callable[[T], bool]):     # O(log n)",
			"        if r <= 0:",
			"            return 0",
			"        r = min(r, self._n) + self.size",
			"        for i in reversed(range(1, self.log + 1)):",
			"            self._push((r - 1) >> i)",
			"        sm = self.e",
			"        while True:",
			"            r -= 1",
			"            while r > 1 and r % 2:",
			"                r >>= 1",
			"            if not f(self.op(self.d[r], sm)):",
			"                while r < self.size:",
			"                    self._push(r)",
			"                    r = 2 * r + 1",
			"                    if f(self.op(self.d[r], sm)):",
			"                        sm = self.op(self.d[r], sm)",
			"                        r -= 1",
			"                return r + 1 - self.size",
			"            sm = self.op(self.d[r], sm)",
			"            if r & -r == r:",
			"                break",
			"        return 0",
			"",
			"    def _update(self, k: int) -> None:",
			"        self.d[k] = self.op(self.d[2 * k], self.d[2 * k + 1])",
			"",
			"    def _all_apply(self, k: int, f: F) -> None:",
			"        self.d[k] = self.mapping(f, self.d[k])",
			"        if k < self.size:",
			"            self.lz[k] = self.composition(f, self.lz[k])",
			"",
			"    def _push(self, k: int) -> None:",
			"        if self.lz[k] == self.id:",
			"            return",
			"        self._all_apply(2 * k, self.lz[k])",
			"        self._all_apply(2 * k + 1, self.lz[k])",
			"        self.lz[k] = self.id",
			"",
			"INF = 10 ** 16",
			"Pair: TypeAlias = tuple[int, int]",
			"def f(x: int, y: int):",
			"    return y if x == INF else x",
			"",
			"def segadd(x: Pair, y: Pair):",
			"    return (x[0] + y[0], x[1] + y[1])",
